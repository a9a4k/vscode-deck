{
  "name": "deck",
  "displayName": "Deck",
  "description": "Switch between git worktrees of multiple registered repositories from a single secondary sidebar tree.",
  "version": "0.9.1",
  "publisher": "a9a4k",
  "repository": {
    "type": "git",
    "url": "https://github.com/a9a4k/vscode-deck.git"
  },
  "bugs": {
    "url": "https://github.com/a9a4k/vscode-deck/issues"
  },
  "homepage": "https://github.com/a9a4k/vscode-deck#readme",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "git",
    "worktree",
    "worktrees",
    "repositories",
    "monorepo"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onView:deck.repositories"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Deck",
      "properties": {
        "deck.confirmTerminalDelete": {
          "type": "boolean",
          "default": true,
          "description": "Controls whether Deck asks for confirmation before deleting a Terminal."
        },
        "deck.agentResumeTemplates.claude": {
          "type": "string",
          "default": "claude --resume {id}",
          "description": "Claude Code command template Deck uses to resume an AgentSession. Include {id} for the session id."
        },
        "deck.agentResumeTemplates.codex": {
          "type": "string",
          "default": "codex resume {id}",
          "description": "Codex command template Deck uses to resume an AgentSession. Include {id} for the session id."
        },
        "deck.notifyOnNeedsInput": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent needs input. Suppressed when you are already viewing that Terminal's tab."
        },
        "deck.notifyOnCompleted": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an agent completes a turn. Suppressed when you are already viewing that Terminal's tab."
        },
        "deck.tmux.automaticRenameFormat": {
          "type": "string",
          "default": "",
          "markdownDescription": "tmux `automatic-rename-format` value for Deck Terminals. Empty uses tmux's default foreground-command naming. See the [tmux Formats guide](https://github.com/tmux/tmux/wiki/Formats) for the `#{…}` syntax and examples."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "deck",
          "title": "Deck",
          "icon": "$(folder)"
        }
      ]
    },
    "views": {
      "deck": [
        {
          "id": "deck.repositories",
          "name": "Repositories & Worktrees"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deck.repositories",
        "contents": "No repositories yet.\n[Add Repository](command:deck.addRepository)"
      }
    ],
    "walkthroughs": [
      {
        "id": "deck.getStarted",
        "title": "Deck",
        "description": "Open Deck from the secondary sidebar.",
        "steps": [
          {
            "id": "deck.secondarySidebar",
            "title": "Deck lives in the secondary sidebar.",
            "description": "Open the secondary sidebar, then select Deck.",
            "media": {
              "markdown": "media/walkthroughs/secondary-sidebar.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.toggleAuxiliaryBar"
            ]
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "deck.terminal",
        "displayName": "Deck Terminal",
        "selector": [
          {
            "filenamePattern": "deck-terminal://**"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "deck.addRepository",
        "title": "Deck: Add Repository",
        "icon": "$(add)"
      },
      {
        "command": "deck.addWorktree",
        "title": "Add Worktree",
        "icon": "$(add)"
      },
      {
        "command": "deck.removeWorktree",
        "title": "Delete Worktree…",
        "icon": "$(trash)"
      },
      {
        "command": "deck.removeRepository",
        "title": "Remove from Deck…"
      },
      {
        "command": "deck.switchWorktree",
        "title": "Switch to Worktree"
      },
      {
        "command": "deck.openWorktreeInNewWindow",
        "title": "Open Worktree in New Window"
      },
      {
        "command": "deck.addTerminal",
        "title": "Add Terminal",
        "icon": "$(add)"
      },
      {
        "command": "deck.openTerminal",
        "title": "Open Terminal"
      },
      {
        "command": "deck.openTerminalInNewWindow",
        "title": "Open Terminal in New Window"
      },
      {
        "command": "deck.killTerminal",
        "title": "Delete Terminal"
      },
      {
        "command": "deck.terminal.find",
        "title": "Deck Terminal: Find"
      },
      {
        "command": "deck.installAgentHooks",
        "title": "Deck: Install Agent Hooks"
      },
      {
        "command": "deck.removeAgentHooks",
        "title": "Deck: Uninstall Agent Hooks"
      },
      {
        "command": "deck.refresh",
        "title": "Deck: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "workbench.view.extension.deck",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+."
      },
      {
        "command": "deck.terminal.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'deck.terminal'"
      },
      {
        "command": "deck.killTerminal",
        "key": "ctrl+backspace",
        "mac": "cmd+backspace",
        "when": "focusedView == 'deck.repositories' && deck.tmuxAvailable"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deck.addRepository",
          "when": "view == deck.repositories",
          "group": "navigation"
        },
        {
          "command": "deck.refresh",
          "when": "view == deck.repositories",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deck.addWorktree",
          "when": "view == deck.repositories && viewItem == deck.repository",
          "group": "inline"
        },
        {
          "command": "deck.addTerminal",
          "when": "view == deck.repositories && (viewItem == deck.worktree || viewItem == deck.worktree.active || viewItem == deck.worktree.main) && deck.tmuxAvailable",
          "group": "inline"
        },
        {
          "command": "deck.switchWorktree",
          "when": "view == deck.repositories && (viewItem == deck.worktree || viewItem == deck.worktree.main)",
          "group": "navigation@1"
        },
        {
          "command": "deck.removeWorktree",
          "when": "view == deck.repositories && (viewItem == deck.worktree || viewItem == deck.worktree.active || viewItem == deck.worktree.main)",
          "group": "navigation@3"
        },
        {
          "command": "deck.openWorktreeInNewWindow",
          "when": "view == deck.repositories && (viewItem == deck.worktree || viewItem == deck.worktree.main)",
          "group": "navigation@2"
        },
        {
          "command": "deck.removeRepository",
          "when": "view == deck.repositories && viewItem == deck.repository",
          "group": "navigation"
        },
        {
          "command": "deck.killTerminal",
          "when": "view == deck.repositories && (viewItem == deck.terminal.active || viewItem == deck.terminal.foreign) && deck.tmuxAvailable",
          "group": "navigation"
        },
        {
          "command": "deck.openTerminalInNewWindow",
          "when": "view == deck.repositories && viewItem == deck.terminal.foreign && deck.tmuxAvailable",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "deck.terminal.find",
          "when": "activeCustomEditorId == 'deck.terminal'"
        },
        {
          "command": "deck.installAgentHooks"
        },
        {
          "command": "deck.removeAgentHooks"
        },
        {
          "command": "deck.switchWorktree",
          "when": "false"
        },
        {
          "command": "deck.addWorktree",
          "when": "false"
        },
        {
          "command": "deck.removeWorktree",
          "when": "false"
        },
        {
          "command": "deck.removeRepository",
          "when": "false"
        },
        {
          "command": "deck.openWorktreeInNewWindow",
          "when": "false"
        },
        {
          "command": "deck.killTerminal",
          "when": "false"
        },
        {
          "command": "deck.addTerminal",
          "when": "false"
        },
        {
          "command": "deck.openTerminal",
          "when": "false"
        },
        {
          "command": "deck.openTerminalInNewWindow",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p . && node scripts/copy-webview-assets.mjs",
    "test": "vitest run",
    "watch": "tsc -w -p .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.7.0",
    "@types/node": "^20.x",
    "@types/vscode": "^1.106.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  }
}
